# Copy to .env (ignored by Git) and fill in for this installation. Non-secret contract only: never put a credential or an owner-specific value here.
# Run from the repository root: docker compose --env-file .env -f deploy/prod/compose.yaml up -d

# Server image to run (the tag produced by deploy/prod/build-image.mjs)
REACH_IMAGE=

# ONE absolute host directory for everything the Server persists (configuration, proposal, logs); mounted at /reach-private.
# It must be writable by uid 1000. Keep it stable across updates: the same path is what preserves the data.
REACH_PRIVATE_PATH=

# Admin plane (port 8788, no login of its own): where it is published on the host and which direct peers the Server admits (addresses or CIDRs).
REACH_ADMIN_BIND=
REACH_ADMIN_ALLOW_FROM=

# Secure MCP Tunnel inputs (separate from the private directory)
REACH_TUNNEL_BINARY=
REACH_TUNNEL_DIR=

# Optional
# REACH_BIND=0.0.0.0
# REACH_PORT=8787
# REACH_ADMIN_PORT=8788
# REACH_CONTAINER_NAME=reach-server
