# Placeholders only: names and shapes, never real values.
# Real values live outside this repository (see docs/configuration.md).
# Names are provisional until the protocol Tasks fix them.

# Which role this process plays: "server" or "client"
REACH_ROLE=server

# Server: port the ChatGPT-facing MCP endpoint listens on
REACH_SERVER_PORT=0

# Client: server address to connect to (outbound only)
REACH_SERVER_URL=

# Shared credential between Client and Server (set a real value outside the repository)
REACH_CLIENT_SECRET=
