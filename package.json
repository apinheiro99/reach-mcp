{
  "name": "reach-mcp",
  "version": "0.0.0",
  "description": "REACH MCP: Remote Environment Access & Context Hub. Controlled access for ChatGPT to explicitly authorized project environments.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.mjs\" && npm test --workspaces",
    "check:public-surface": "node scripts/public-surface.mjs",
    "check:package": "node scripts/check-package-contents.mjs",
    "validate": "npm run check:public-surface && npm run lint && npm run typecheck && npm test && npm run check:package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "workspaces": [
    "packages/shared",
    "packages/legacy/git-compat",
    "packages/client",
    "packages/server"
  ]
}
