# REACH MCP Client on the DEV container, run from the installed release artifact (deploy/client/install-linux.sh), not from a source
# checkout. The endpoint, Client id, credential and root anchors live only in the bootstrap
# file below (mode 0600), never in this unit. --allow-insecure-ws is the explicit DEV switch for a ws:// loopback endpoint.
[Unit]
Description=REACH MCP Client (DEV)
After=reach-mcp-server.service
Wants=reach-mcp-server.service

[Service]
Type=simple
User=dev
ExecStart=/usr/local/bin/node /opt/reach-mcp-client/reach-client.mjs --bootstrap /reach/reach-private/runtime/client/bootstrap.env --build dev --allow-insecure-ws
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
