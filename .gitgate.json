{
  "version": 1,
  "integration_branch": "main",
  "remote": "origin",
  "publish_on": ["story-done"],
  "levels": ["sprint", "story", "task"],
  "branch_prefix": { "sprint": "feature/sprint-", "story": "feature/story-", "task": "feature/task-" },
  "ci_gate": { "enabled": true },
  "templates": { "commit": "2.0.0", "merge": "1.0.0", "init": "1.0.0" },
  "free_branch_types": ["docs", "chore", "ci"]
}
